<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Speranza Archive - Arc Raiders Tracker</title>
    <style>
        :root {
            --bg-color: #0b0c10;
            --card-bg: #1f2833;
            --text-main: #c5c6c7;
            --accent: #66fcf1;
            --accent-dark: #45a29e;
            --border: #2d3436;
            --font-main: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: var(--font-main);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* Header & Nav */
        header {
            background: rgba(11, 12, 16, 0.95);
            border-bottom: 1px solid var(--accent-dark);
            padding: 1rem 2rem;
            position: sticky;
            top: 0;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            backdrop-filter: blur(10px);
        }

        .logo {
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 20px;
            margin: 0;
            padding: 0;
        }

        nav li {
            cursor: pointer;
            padding: 5px 10px;
            border-radius: 4px;
            transition: all 0.3s ease;
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 1px;
        }

        nav li:hover, nav li.active {
            background-color: var(--accent-dark);
            color: #fff;
        }

        .controls {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        select, button {
            background: var(--card-bg);
            color: var(--text-main);
            border: 1px solid var(--accent-dark);
            padding: 5px 10px;
            border-radius: 4px;
            cursor: pointer;
            font-family: inherit;
        }

        button:hover {
            background: var(--accent);
            color: var(--bg-color);
        }

        /* Main Content */
        main {
            padding: 2rem;
            max-width: 1400px;
            margin: 0 auto;
        }

        .stats-bar {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
            padding: 15px;
            background: var(--card-bg);
            border-radius: 8px;
            border-left: 4px solid var(--accent);
        }

        .stat-item {
            font-size: 0.9rem;
        }

        .stat-value {
            font-weight: bold;
            color: var(--accent);
            font-size: 1.1rem;
        }

        /* Grid */
        .items-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
        }

        .item-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            transition: transform 0.2s, box-shadow 0.2s;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .item-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(102, 252, 241, 0.2);
            border-color: var(--accent);
        }

        .item-card img {
            width: 100%;
            height: 150px;
            object-fit: contain;
            margin-bottom: 10px;
            filter: drop-shadow(0 0 5px rgba(0,0,0,0.5));
        }

        .item-name {
            font-weight: bold;
            margin-bottom: 5px;
            font-size: 0.95rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .item-type {
            font-size: 0.8rem;
            color: var(--accent-dark);
            text-transform: uppercase;
        }

        .rarity-common { border-bottom: 3px solid #b0b0b0; }
        .rarity-uncommon { border-bottom: 3px solid #5eff5e; }
        .rarity-rare { border-bottom: 3px solid #5e9eff; }
        .rarity-epic { border-bottom: 3px solid #d65eff; }
        .rarity-legendary { border-bottom: 3px solid #ffaa5e; }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(5px);
        }

        .modal-content {
            background: var(--card-bg);
            padding: 2rem;
            border-radius: 12px;
            max-width: 600px;
            width: 90%;
            border: 1px solid var(--accent);
            position: relative;
            box-shadow: 0 0 30px rgba(102, 252, 241, 0.15);
        }

        .close-btn {
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--text-main);
        }

        .modal-body {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .modal-img {
            max-width: 200px;
            margin-bottom: 20px;
        }

        .modal-info h2 {
            color: var(--accent);
            margin-top: 0;
        }

        .modal-details {
            width: 100%;
            margin-top: 20px;
            text-align: left;
            border-top: 1px solid var(--border);
            padding-top: 15px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 0.9rem;
        }

        .detail-label {
            color: var(--accent-dark);
        }

        /* Loading */
        #loading {
            text-align: center;
            padding: 50px;
            font-size: 1.2rem;
            color: var(--accent);
        }

        .hidden { display: none; }

        /* Filters */
        .filters-container {
            margin-bottom: 20px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            background: var(--card-bg);
            padding: 15px;
            border-radius: 8px;
        }

        .filter-group {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-right: 20px;
        }

        .filter-label {
            font-size: 0.85rem;
            text-transform: uppercase;
            color: var(--accent-dark);
        }

    </style>
</head>
<body>

<header>
    <div class="logo">Speranza Archive <span style="font-size:0.8rem; color:#fff; opacity:0.7;">v1.17.29-QAI</span></div>
    <nav>
        <ul id="nav-menu">
            <li data-key="nav_items" class="active">Items</li>
            <li data-key="nav_blueprints">Blueprints</li>
            <li data-key="nav_cosmetics">Cosmetics</li>
            <li data-key="nav_events">Events</li>
            <li data-key="nav_maps">Maps</li>
        </ul>
    </nav>
    <div class="controls">
        <select id="lang-select">
            <option value="it">ITA</option>
            <option value="en">ENG</option>
            <option value="es">ESP</option>
            <option value="fr">FRA</option>
        </select>
        <button id="connect-btn" data-key="ui_connect">CONNETTITI</button>
    </div>
</header>

<main>
    <div id="loading">Caricamento Archivio...</div>

    <div id="content-area" class="hidden">
        <div class="stats-bar">
            <div class="stat-item"><span data-key="stat_total">Totale Oggetti</span>: <span id="count-total" class="stat-value">0</span></div>
            <div class="stat-item"><span data-key="stat_blueprints">Blueprints</span>: <span id="count-blueprints" class="stat-value">0</span></div>
            <div class="stat-item"><span data-key="stat_cosmetics">Cosmetici</span>: <span id="count-cosmetics" class="stat-value">0</span></div>
        </div>

        <div class="filters-container" id="filters-area">
            <!-- Filtri generati dinamicamente -->
        </div>

        <div class="items-grid" id="items-grid">
            <!-- Items generati dinamicamente -->
        </div>
    </div>
</main>

<!-- Modal Dettaglio -->
<div id="item-modal" class="modal">
    <div class="modal-content">
        <span class="close-btn">&times;</span>
        <div class="modal-body">
            <img src="" alt="" class="modal-img" id="m-img">
            <div class="modal-info">
                <h2 id="m-name">Nome Item</h2>
                <div class="item-type" id="m-type">Tipo</div>
                <div class="modal-details" id="m-details">
                    <!-- Dettagli extra -->
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // --- CONFIGURAZIONE E STATO ---
    const VERSION = "1.17.29-QAI";
    let currentLang = 'it';
    let isConnected = false;
    let allData = {
        inventory: [],
        blueprints: [],
        cosmetics: []
    };
    let translations = {};

    // --- ELEMENTI DOM ---
    const els = {
        loading: document.getElementById('loading'),
        content: document.getElementById('content-area'),
        grid: document.getElementById('items-grid'),
        filters: document.getElementById('filters-area'),
        modal: document.getElementById('item-modal'),
        connectBtn: document.getElementById('connect-btn'),
        langSelect: document.getElementById('lang-select'),
        counts: {
            total: document.getElementById('count-total'),
            blueprints: document.getElementById('count-blueprints'),
            cosmetics: document.getElementById('count-cosmetics')
        },
        nav: document.querySelectorAll('#nav-menu li')
    };

    // --- INIZIALIZZAZIONE ---
    function init() {
        els.langSelect.addEventListener('change', (e) => {
            currentLang = e.target.value;
            applyLanguage();
            renderGrid(getCurrentView());
        });

        els.connectBtn.addEventListener('click', toggleConnection);
        
        els.modal.querySelector('.close-btn').addEventListener('click', () => {
            els.modal.style.display = 'none';
        });

        els.nav.forEach(li => {
            li.addEventListener('click', () => {
                els.nav.forEach(n => n.classList.remove('active'));
                li.classList.add('active');
                renderGrid(li.dataset.key);
            });
        });

        // Avvio caricamento dati (simulato senza connessione reale per ora)
        loadData();
    }

    // --- GESTIONE DATI ---
    async function loadData() {
        try {
            // Caricamento parallelo delle tre fonti
            const [invRes, bpRes, cosRes] = await Promise.all([
                fetch('items/inventory/data.json').then(r => r.json()),
                fetch('items/blueprints/data.json').then(r => r.json()),
                fetch('items/cosmetics/data.json').then(r => r.json())
            ]);

            allData.inventory = invRes;
            allData.blueprints = bpRes;
            allData.cosmetics = cosRes;

            // Caricamento traduzioni
            await loadTranslations();

            els.loading.classList.add('hidden');
            els.content.classList.remove('hidden');
            
            updateStats();
            applyLanguage();
            renderGrid('nav_items'); // Default view

        } catch (error) {
            console.error("Errore caricamento dati:", error);
            els.loading.innerHTML = "Errore nel caricamento dei dati. Controlla la console.";
        }
    }

    async function loadTranslations() {
        try {
            const res = await fetch(`locales/${currentLang}.json`);
            translations = await res.json();
        } catch (e) {
            console.warn("Traduzioni non trovate, uso fallback");
            translations = {};
        }
    }

    function toggleConnection() {
        isConnected = !isConnected;
        if (isConnected) {
            els.connectBtn.textContent = translations.ui?.disconnect || "DISCONNETTI";
            els.connectBtn.style.background = "#ff4444";
            els.connectBtn.style.color = "#fff";
            // Qui si potrebbe triggerare il download effettivo se servisse
            loadData(); 
        } else {
            els.connectBtn.textContent = translations.ui?.connect || "CONNETTITI";
            els.connectBtn.style.background = "";
            els.connectBtn.style.color = "";
        }
    }

    // --- RENDERING ---
    function getCurrentView() {
        const active = document.querySelector('#nav-menu li.active');
        return active ? active.dataset.key : 'nav_items';
    }

    function updateStats() {
        els.counts.total.textContent = allData.inventory.length + allData.blueprints.length + allData.cosmetics.length;
        els.counts.blueprints.textContent = allData.blueprints.length;
        els.counts.cosmetics.textContent = allData.cosmetics.length;
    }

    function renderGrid(viewKey) {
        els.grid.innerHTML = '';
        els.filters.innerHTML = '';

        let dataSet = [];
        if (viewKey === 'nav_items') dataSet = allData.inventory;
        else if (viewKey === 'nav_blueprints') dataSet = allData.blueprints;
        else if (viewKey === 'nav_cosmetics') dataSet = allData.cosmetics;
        else dataSet = []; // Events/Maps placeholder

        // Generazione Filtri (solo per Inventory per ora come esempio)
        if (viewKey === 'nav_items' && dataSet.length > 0) {
            createFilters(dataSet);
        }

        dataSet.forEach(item => {
            const card = document.createElement('div');
            card.className = `item-card rarity-${item.rarity || 'common'}`;
            
            // Correzione percorso immagine
            let imgUrl = item.image_url || '';
            if(imgUrl.includes('cdn.arctracker.io')) {
                imgUrl = imgUrl.replace('https://cdn.arctracker.io/items/v2/', 'images/items/');
            } else if (!imgUrl.startsWith('images/')) {
                imgUrl = 'images/items/' + imgUrl;
            }

            card.innerHTML = `
                <img src="${imgUrl}" alt="${item.name}" loading="lazy">
                <div class="item-name">${item.name}</div>
                <div class="item-type">${item.type}</div>
            `;
            
            card.addEventListener('click', () => showModal(item, imgUrl));
            els.grid.appendChild(card);
        });
    }

    function createFilters(data) {
        // Logica semplificata per i filtri basata sulle chiavi JSON
        const categories = [...new Set(data.map(i => i.category).filter(Boolean))];
        
        if(categories.length > 0) {
            const group = document.createElement('div');
            group.className = 'filter-group';
            
            const label = document.createElement('span');
            label.className = 'filter-label';
            label.textContent = translations.filters?.category || "Categoria";
            
            const select = document.createElement('select');
            select.innerHTML = `<option value="all">Tutti</option>`;
            categories.forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat;
                opt.textContent = cat;
                select.appendChild(opt);
            });

            select.addEventListener('change', (e) => {
                const val = e.target.value;
                const cards = document.querySelectorAll('.item-card');
                cards.forEach(card => {
                    // Logica di filtraggio visuale semplificata
                    // In un'app reale si rifarebbe il renderGrid con i dati filtrati
                    const typeInCard = card.querySelector('.item-type').textContent; 
                    // Nota: qui servirebbe un mapping più robusto tra card e dato originale
                    // Per brevità, lasciamo la struttura pronta per l'implementazione completa
                });
            });

            group.appendChild(label);
            group.appendChild(select);
            els.filters.appendChild(group);
        }
    }

    function showModal(item, imgUrl) {
        document.getElementById('m-img').src = imgUrl;
        document.getElementById('m-name').textContent = item.name;
        document.getElementById('m-type').textContent = `${item.type} - ${item.rarity || 'Common'}`;
        
        const detailsDiv = document.getElementById('m-details');
        detailsDiv.innerHTML = '';
        
        // Aggiungi dettagli dinamici
        const addDetail = (label, value) => {
            if(value) {
                detailsDiv.innerHTML += `
                    <div class="detail-row">
                        <span class="detail-label">${label}:</span>
                        <span>${value}</span>
                    </div>
                `;
            }
        };

        addDetail(translations.details?.rarity || "Rarità", item.rarity);
        addDetail(translations.details?.category || "Categoria", item.category);
        addDetail("ID", item.id);
        
        els.modal.style.display = 'flex';
    }

    // --- LOCALIZZAZIONE ---
    function applyLanguage() {
        // Texti statici
        document.querySelectorAll('[data-key]').forEach(el => {
            const key = el.dataset.key;
            const parts = key.split('_');
            const section = parts[0].toLowerCase(); // ui, nav, stat, filt
            const sub = parts.slice(1).join('_').toLowerCase();
            
            if (translations[section] && translations[section][sub]) {
                el.textContent = translations[section][sub];
            }
        });

        // Aggiorna bottone se connesso
        if(isConnected) {
            els.connectBtn.textContent = translations.ui?.disconnect || "DISCONNETTI";
        } else {
            els.connectBtn.textContent = translations.ui?.connect || "CONNETTITI";
        }
    }

    // Start
    init();

</script>
</body>
</html>